# Class: obo:CHMO_0001685 (mixing)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://doi.org/10.1351/goldbook.M03945") obo:IAO_0000115 obo:CHMO_0001685 "The combining of components, particles or layers into a more homogeneous state. The mixing may be achieved manually or mechanically by shifting the material with stirrers or pumps or by revolving or shaking the container. The process μst not permit segregation of particles of different size or properties. Homogeneity may be considered to have been achieved in a practical sense when the sampling error of the processed portion is negligible compared to the total error of the measurement system.")
AnnotationAssertion(oboInOwl:id obo:CHMO_0001685 "CHMO:0001685")
AnnotationAssertion(rdfs:label obo:CHMO_0001685 "mixing")
SubClassOf(obo:CHMO_0001685 obo:COB_0000110)

# Class: obo:CHMO_0001988 (aerosol method)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "ISBN:0815515804") obo:IAO_0000115 obo:CHMO_0001988 "A method for the synthesis of solid particles from an aerosol. The desired solid particles are suspended in a liquid, which is heated to 275–330 °C under pressure and passed through an orifice so that an aerosol forms. The particles in the aerosol are polymerised by partial evaporation of the solvent.")
AnnotationAssertion(oboInOwl:created_by obo:CHMO_0001988 "https://orcid.org/0000-0001-5985-7429")
AnnotationAssertion(oboInOwl:creation_date obo:CHMO_0001988 "2009-06-18T10:08:38Z")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:CHMO_0001988 "aerosol process")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:CHMO_0001988 "aerosol processing")
AnnotationAssertion(oboInOwl:id obo:CHMO_0001988 "CHMO:0001988")
AnnotationAssertion(rdfs:label obo:CHMO_0001988 "aerosol method")
SubClassOf(obo:CHMO_0001988 obo:CHMO_0002063)

