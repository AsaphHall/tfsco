SubClassOf(<http://purl.obolibrary.org/obo/OBI_0000185> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000299> <http://purl.obolibrary.org/obo/IAO_0000101>))
SubClassOf(<http://purl.obolibrary.org/obo/OBI_0000185> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/IAO_0000101>))

# Class: <http://purl.obolibrary.org/obo/OBI_0000339> (planning)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBI_0000339> "a process of creating or modifying a plan specification"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/OBI_0000339> "Bjoern Peters")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/OBI_0000339> "Plans and Planned Processes Branch")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBI_0000339> "planning"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OBI_0000339> <http://purl.obolibrary.org/obo/BFO_0000015>)
