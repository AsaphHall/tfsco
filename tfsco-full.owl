        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000219"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A method for determining structure by directing a beam of X-rays at an extremely flat surface and measuring the intensity of the reflected X-rays as a function of angle. X-ray reflectometry is used to determine the structure of thin films.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0000228 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000800"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The study of the interaction of a sample with radiation or particles for measurement or detection.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>spectrometry</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000228</oboInOwl:id>
        <rdfs:label>spectroscopy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000228"/>
