     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/tfsco/tfsco-full.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/tfsco/releases/2026-03-17/tfsco-full.owl"/>
        <dcterms:description>Domain ontology for thin-film solar cells and related tandem solar cells. Contains relevant terms and concepts from BFO, IAO, UO, PATO, OBI, CHMO.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title>Ontology for thin-film solar cells</dcterms:title>
        <owl:versionInfo>2026-03-17</owl:versionInfo>
    </owl:Ontology>
    


