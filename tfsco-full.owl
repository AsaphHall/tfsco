        <obo:IAO_0000115 xml:lang="en">A planned process with the objective to create a group of entities by applying a predefined criteria to a larger group of entities.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">selection process</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">OBI</obo:IAO_0000119>
        <rdfs:label xml:lang="en">selection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002900 -->

