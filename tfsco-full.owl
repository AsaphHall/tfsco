        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000209"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any method for determining structure by directing a beam of particles or X-rays onto an extremely flat surface and measuring the intensity of the reflected radiation as a function of angle.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0000219 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000219">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000209"/>
        <obo:IAO_0000115>A method for determining structure by directing a beam of X-rays at an extremely flat surface and measuring the intensity of the reflected X-rays as a function of angle. X-ray reflectometry is used to determine the structure of thin films.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>X-ray reflectivity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>XRR</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000219</oboInOwl:id>
        <rdfs:label>X-ray reflectometry</rdfs:label>
    </owl:Class>
