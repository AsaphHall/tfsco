    <!-- http://purl.obolibrary.org/obo/CHMO_0000209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000208"/>
        <obo:IAO_0000115>Any method for determining structure by directing a beam of particles or X-rays onto an extremely flat surface and measuring the intensity of the reflected radiation as a function of angle.</obo:IAO_0000115>
