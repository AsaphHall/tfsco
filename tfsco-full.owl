    <!-- http://purl.obolibrary.org/obo/CHMO_0001341 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001336"/>
        <obo:IAO_0000115>A synthesis method which consists of depositing a monocrystalline film (from a molecular beam) on a monocrystalline substrate under high vacuum (&lt;10^{-8} Pa). Molecular beam epitaxy is very slow, with a deposition rate of &lt;1000 nm per hour.</obo:IAO_0000115>
