        <obo:IAO_0000119 xml:lang="en">OBI discussion summarized under the following tracker item : http://sourceforge.net/p/obi/obi-terms/678/</obo:IAO_0000119>
        <rdfs:label xml:lang="en">selection criterion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001928 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001928">
